{
  "enabledMcpjsonServers": [
    "supabase"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__supabase__apply_migration|mcp__supabase__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "npm run supabase-typegen 2>/dev/null || true",
            "timeout": 120,
            "statusMessage": "Regenerating Supabase types..."
          }
        ]
      }
    ]
  }
}
